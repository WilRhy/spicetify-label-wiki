(async function WilRhyCreditsExt() {
    // Wait for Spicetify to load
    while (!Spicetify?.showNotification) {
        await new Promise(resolve => setTimeout(resolve, 100));
    }

    const GITHUB_USER = "WilRhy";
    const REPO_NAME = "spicetify-label-wiki";

    async function openLabelWiki(labelName) {
        // Format label name for the GitHub file (e.g., "Paper Vinyl Records" -> "paper-vinyl-records.json")
        const fileName = labelName.toLowerCase().replace(/[^a-z0-9]+/g, '-') + '.json';
        const rawUrl = `https://raw.githubusercontent.com/${GITHUB_USER}/${REPO_NAME}/main/labels/${fileName}`;
        const editUrl = `https://github.com/${GITHUB_USER}/${REPO_NAME}/edit/main/labels/${fileName}`;
        const createUrl = `https://github.com/${GITHUB_USER}/${REPO_NAME}/new/main/labels?filename=${fileName}`;
        
        try {
            const response = await fetch(rawUrl);
            if (response.ok) {
                const data = await response.json();
                Spicetify.PopupModal.display({
                    title: labelName,
                    content: `<div style="padding: 10px;">
                        <p style="font-size: 14px; margin-bottom: 15px;">${data.description}</p>
                        <a href="${editUrl}" target="_blank" style="color: #1db954; font-weight: bold; text-decoration: underline;">Edit this page on GitHub</a>
                    </div>`
                });
            } else {
                Spicetify.PopupModal.display({
                    title: labelName,
                    content: `<div style="padding: 10px;">
                        <p style="font-size: 14px; margin-bottom: 15px;">No community wiki exists for this label yet.</p>
                        <a href="${createUrl}" target="_blank" style="color: #1db954; font-weight: bold; text-decoration: underline;">Create this page on GitHub</a>
                    </div>`
                });
            }
        } catch (error) {
            console.error("Error fetching data:", error);
        }
    }

    // Observer to intercept C and P lines / Source text
    const observer = new MutationObserver(() => {
        // Find all plain text paragraphs in the Spotify UI
        const paragraphs = document.querySelectorAll('p[dir="auto"]');
        
        paragraphs.forEach(p => {
            if (p.innerText.startsWith("Source: ") && !p.dataset.modified) {
                p.dataset.modified = "true";
                const labelName = p.innerText.replace("Source: ", "").trim();
                
                // Replace text with a clickable link
                p.innerHTML = `Source: <a href="#" class="custom-label-link" style="color: #1db954; text-decoration: underline; cursor: pointer;">${labelName}</a>`;
                
                p.querySelector('.custom-label-link').addEventListener("click", (e) => {
                    e.preventDefault();
                    openLabelWiki(labelName);
                });
            }
        });
    });

    observer.observe(document.body, { childList: true, subtree: true });
})();
